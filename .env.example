# Copy to ~/.config/telegram-mcp/.env (or let `telegram-mcp login` create it)
# From https://my.telegram.org → API development tools (or copy from TelegramAutobot/.env)
API_ID=
API_HASH=
# International format, only needed for code login (not for QR login)
PHONE_NUMBER=
# Optional: 2FA password for non-interactive login (otherwise prompted)
# TG_PASSWORD=
# Optional: allow send_message / mark_read tools
# TELEGRAM_MCP_ALLOW_WRITE=true
# Optional: inject the session via env instead of session.txt
# TG_SESSION=
