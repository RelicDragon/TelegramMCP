{
  "name": "telegram-mcp",
  "version": "1.0.0",
  "description": "MCP server exposing your Telegram account (chats, groups, channels, messages) to LLMs",
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "telegram-mcp": "src/server.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "login": "node src/login.js",
    "login:qr": "node src/login.js qr",
    "status": "node src/login.js status",
    "logout": "node src/login.js logout",
    "register:claude": "bash scripts/register-claude.sh"
  },
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "dotenv": "^18.0.8",
    "qrcode-terminal": "^0.12.0",
    "telegram": "^2.26.22",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=20"
  }
}
